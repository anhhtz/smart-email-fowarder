# ==============================================================================
# Google OAuth2 Authentication Configuration
# ==============================================================================
# Create an OAuth 2.0 Web Application client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URIs must include:
# http://localhost:8080/api/auth/oauth/google/callback

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback
GOOGLE_SCOPES=openid email profile
# Whitelist of authorized emails for Google OAuth2 (comma-separated).
# Example: ALLOWED_EMAILS=user@company.com, admin@gmail.com
ALLOWED_EMAILS=
